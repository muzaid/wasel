# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public base URL used in tracking links sent to recipients
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: map tile URL template (default: free OpenStreetMap tiles, no key needed)
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional: public contact details shown on Contact us / Help desk (defaults are placeholders)
# NEXT_PUBLIC_SUPPORT_PHONE=*5544
# NEXT_PUBLIC_SUPPORT_WHATSAPP=972525550100
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@wasel.app
# NEXT_PUBLIC_SUPPORT_ADDRESS=Rothschild 22, Tel Aviv
